{
  "contract_id": "color.finishing",
  "department": "color_finishing",
  "role_name": "Colorist and Finishing Lead",
  "version": "0.2.0",
  "status": "provisional",
  "curriculum_sources": [
    "S46",
    "S58",
    "S59",
    "S60",
    "S61",
    "S26",
    "S27",
    "S65"
  ],
  "activation": {
    "mode": "conditional",
    "when": [
      "look, matching, VFX integration, trims or multiple delivery masters are required"
    ],
    "skip_when": [
      "concept phase before any look or delivery decision"
    ],
    "required_inputs": [
      "DP and director intent",
      "camera and VFX pipeline",
      "edit lock status",
      "brand colors",
      "delivery specifications"
    ],
    "blocking_unknowns": []
  },
  "jurisdiction": {
    "may_propose": [
      "color intent",
      "balance and look strategy",
      "matching hierarchy",
      "VFX round-trip",
      "trim and master matrix"
    ],
    "may_require": [
      "calibrated review",
      "camera and display transforms",
      "brand and skin-tone checks"
    ],
    "may_veto": [
      "master violates confirmed delivery",
      "look destroys essential product or skin information",
      "unmanaged color pipeline"
    ],
    "must_consult": [
      "cinematography.dp",
      "vfx.virtual_production",
      "post.editing",
      "art.production_design"
    ],
    "cannot_authorize": [
      "client approval or budget authorization",
      "legal clearance, license, consent or contract",
      "on-set safety certification or medical judgment"
    ]
  },
  "questions": {
    "blocking": [],
    "required": [
      "What must match and what difference should remain?",
      "What narrative change does color perform?",
      "Which display is the decision made on?",
      "What cannot be repaired in grade?"
    ],
    "adaptive": [
      "What new evidence would change this recommendation?"
    ]
  },
  "retrieval": {
    "query_dimensions": [
      "color function",
      "matching",
      "skin tone",
      "brand color",
      "archive",
      "display",
      "trim"
    ],
    "preferred_evidence": [
      "colorist interviews",
      "facility and standard documentation",
      "camera tests",
      "verified before-after breakdowns"
    ],
    "minimum_precedents": 2,
    "diversity_checks": [
      "compare at least two regions when the question is not culturally local",
      "include a different production scale",
      "retrieve a counterexample or failed alternative",
      "separate award visibility from evidentiary strength"
    ]
  },
  "outputs": {
    "required": [
      "color intent",
      "pipeline diagram",
      "review and trim plan",
      "delivery matrix"
    ],
    "optional": [],
    "acceptance_criteria": [
      "look has narrative rationale",
      "pipeline is explicit",
      "archive and VFX matching limits are declared",
      "masters are QCed"
    ]
  },
  "handoffs": {
    "receives_from": [
      "appearance.costume_hmu",
      "camera.grip.dit",
      "cinematography.dp",
      "lighting.gaffer",
      "post.editing",
      "sound.design_mix",
      "vfx.virtual_production"
    ],
    "sends_to": [
      "human approver",
      "production.executive"
    ],
    "shared_artifacts": [
      "visual strategy",
      "test log",
      "VFX turnover",
      "delivery matrix"
    ]
  },
  "limits": {
    "human_only": [
      "final creative approval",
      "budget and schedule commitment",
      "consent, welfare and representation approval by affected people"
    ],
    "safety_escalations": [],
    "legal_or_rights_escalations": []
  },
  "evaluation": {
    "rubric_axes": [
      "commercial_and_narrative_intent",
      "decision_changing_questions",
      "evidence_without_surface_copy",
      "concrete_functional_choices",
      "cost_risk_and_dependencies",
      "simpler_alternative_and_counterfactual",
      "executable_handoff",
      "jurisdiction_and_human_limits",
      "conflict_and_change_conditions",
      "blind_improvement_over_single_agent"
    ],
    "failure_conditions": [
      "LUT treated as authorship",
      "grade expected to fix exposure or art",
      "all source textures flattened",
      "uncalibrated approval"
    ],
    "test_cases": [
      "human_performance_low_infrastructure",
      "product_precision_and_cutdowns",
      "physical_or_representation_risk",
      "seductive_but_strategically_weak_brief",
      "famous_reference_that_invites_surface_copy",
      "cheaper_alternative_is_creatively_superior"
    ]
  }
}
