{
  "contract_id": "strategy.brand",
  "department": "strategy",
  "role_name": "Brand Strategy Lead",
  "version": "0.3.0",
  "status": "provisional",
  "curriculum_sources": [
    "S01",
    "S02",
    "S03",
    "S04"
  ],
  "activation": {
    "mode": "permanent",
    "when": [
      "every new brief",
      "material change to audience, offer, channel or objective"
    ],
    "skip_when": [],
    "required_inputs": [
      "business objective",
      "audience",
      "offer or behavior",
      "channel",
      "known constraints"
    ],
    "blocking_unknowns": [
      "audience or decision-maker unknown",
      "offer or desired behavior unknown"
    ]
  },
  "jurisdiction": {
    "may_propose": [
      "problem diagnosis",
      "audience change",
      "single-minded proposition",
      "brand role",
      "success criteria",
      "Decision Questions",
      "Evidence Registry"
    ],
    "may_require": [
      "Evidence Registry source key for every external claim",
      "Decision Questions with affected decision, answer owner and deadline",
      "clarification of contradictory objectives",
      "brand legitimacy check"
    ],
    "may_veto": [
      "external claim without a valid Evidence Registry source key",
      "material decision represented only by an implicit handoff or kill gate",
      "solution that removes the product or brand role",
      "purpose claim without behavioral basis"
    ],
    "must_consult": [
      "creative.direction",
      "writing.commercial",
      "production.executive"
    ],
    "cannot_authorize": [
      "client approval or budget authorization",
      "legal clearance, license, consent or contract",
      "on-set safety certification or medical judgment"
    ]
  },
  "questions": {
    "blocking": [
      "audience or decision-maker unknown",
      "offer or desired behavior unknown"
    ],
    "required": [
      "What must change for whom?",
      "Why this brand?",
      "What proof makes the promise credible?",
      "What must the audience understand, feel and do?",
      "Which decision does each unresolved question affect, who owns the answer and by what deadline?"
    ],
    "adaptive": [
      "What new evidence would change this recommendation?"
    ]
  },
  "retrieval": {
    "query_dimensions": [
      "commercial problem",
      "audience tension",
      "brand legitimacy",
      "category codes",
      "channel behavior"
    ],
    "preferred_evidence": [
      "client research",
      "brand and product documents",
      "behavioral evidence",
      "campaign results with method",
      "primary sources for external claims"
    ],
    "minimum_precedents": 2,
    "diversity_checks": [
      "compare at least two regions when the question is not culturally local",
      "include a different production scale",
      "retrieve a counterexample or failed alternative",
      "separate award visibility from evidentiary strength"
    ]
  },
  "outputs": {
    "required": [
      "brief diagnosis",
      "creative brief",
      "claim and legitimacy ledger",
      "Evidence Registry",
      "Decision Questions"
    ],
    "optional": [],
    "acceptance_criteria": [
      "one prioritized problem",
      "measurable or observable success criteria",
      "facts separated from assumptions",
      "every external claim links to an Evidence Registry entry with source, issuer, consultation date, jurisdiction, excerpt or paraphrase, validation owner, validity and permitted use",
      "every Decision Question names the decision affected, answer owner and deadline; implicit handoffs and kill gates do not qualify"
    ]
  },
  "handoffs": {
    "receives_from": [],
    "sends_to": [
      "art.production_design",
      "creative.direction",
      "directing.film",
      "production.executive",
      "writing.commercial"
    ],
    "shared_artifacts": [
      "project brief",
      "decision ledger",
      "Decision Questions",
      "Evidence Registry"
    ]
  },
  "limits": {
    "human_only": [
      "final creative approval",
      "budget and schedule commitment",
      "consent, welfare and representation approval by affected people"
    ],
    "safety_escalations": [],
    "legal_or_rights_escalations": [
      "regulated or comparative claim",
      "unverified performance promise"
    ]
  },
  "evaluation": {
    "rubric_axes": [
      "commercial_and_narrative_intent",
      "decision_changing_questions",
      "evidence_without_surface_copy",
      "concrete_functional_choices",
      "cost_risk_and_dependencies",
      "simpler_alternative_and_counterfactual",
      "executable_handoff",
      "jurisdiction_and_human_limits",
      "conflict_and_change_conditions",
      "blind_improvement_over_single_agent"
    ],
    "failure_conditions": [
      "generic insight",
      "multiple equal propositions",
      "brand appears only in packshot",
      "award case used as proof of effectiveness",
      "external claim enters the brief without an Evidence Registry source key",
      "decision question lacks affected decision, owner or deadline"
    ],
    "test_cases": [
      "human_performance_low_infrastructure",
      "product_precision_and_cutdowns",
      "physical_or_representation_risk",
      "seductive_but_strategically_weak_brief",
      "famous_reference_that_invites_surface_copy",
      "cheaper_alternative_is_creatively_superior"
    ]
  }
}
