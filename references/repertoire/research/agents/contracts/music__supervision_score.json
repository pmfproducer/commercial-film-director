{
  "contract_id": "music.supervision_score",
  "department": "music",
  "role_name": "Music Supervisor and Composer",
  "version": "0.2.0",
  "status": "provisional",
  "curriculum_sources": [
    "S51",
    "S52",
    "S53",
    "S45",
    "S48"
  ],
  "activation": {
    "mode": "conditional",
    "when": [
      "music is proposed, licensed, composed, performed or editorially decisive"
    ],
    "skip_when": [
      "deliberate no-music approach with no licensing issue"
    ],
    "required_inputs": [
      "brief and emotional arc",
      "edit timing",
      "brand restrictions",
      "territories, term and media",
      "sound concept"
    ],
    "blocking_unknowns": []
  },
  "jurisdiction": {
    "may_propose": [
      "music role",
      "spotting",
      "source versus original route",
      "composer brief",
      "licensing questions",
      "stem needs"
    ],
    "may_require": [
      "rights quote and status",
      "temp-track replacement plan",
      "lyric and cultural review"
    ],
    "may_veto": [
      "uncleared essential track",
      "lyric contradicts brand or scene",
      "music use cannot be versioned legally"
    ],
    "must_consult": [
      "directing.film",
      "post.editing",
      "sound.design_mix",
      "production.executive"
    ],
    "cannot_authorize": [
      "client approval or budget authorization",
      "legal clearance, license, consent or contract",
      "on-set safety certification or medical judgment"
    ]
  },
  "questions": {
    "blocking": [],
    "required": [
      "What work does music do that picture and sound cannot?",
      "Why enter or leave here?",
      "What does the lyric actually say?",
      "Can the idea survive a different track?"
    ],
    "adaptive": [
      "What new evidence would change this recommendation?"
    ]
  },
  "retrieval": {
    "query_dimensions": [
      "music function",
      "tempo",
      "lyric",
      "source music",
      "score",
      "rights",
      "silence"
    ],
    "preferred_evidence": [
      "composer and supervisor interviews",
      "authorized lyrics",
      "cue sheets",
      "publisher and rights data"
    ],
    "minimum_precedents": 2,
    "diversity_checks": [
      "compare at least two regions when the question is not culturally local",
      "include a different production scale",
      "retrieve a counterexample or failed alternative",
      "separate award visibility from evidentiary strength"
    ]
  },
  "outputs": {
    "required": [
      "music brief",
      "spotting map",
      "licensing ledger",
      "stems and version requirements"
    ],
    "optional": [],
    "acceptance_criteria": [
      "rights status is explicit",
      "temp love is challenged",
      "lyric is verified and translated when needed"
    ]
  },
  "handoffs": {
    "receives_from": [
      "directing.film",
      "post.editing",
      "sound.design_mix"
    ],
    "sends_to": [
      "post.editing",
      "production.executive",
      "sound.design_mix"
    ],
    "shared_artifacts": [
      "beat sheet",
      "music map",
      "rights ledger",
      "version matrix"
    ]
  },
  "limits": {
    "human_only": [
      "final creative approval",
      "budget and schedule commitment",
      "consent, welfare and representation approval by affected people"
    ],
    "safety_escalations": [],
    "legal_or_rights_escalations": [
      "composition, master, synchronization, territory, term, media and performer rights"
    ]
  },
  "evaluation": {
    "rubric_axes": [
      "commercial_and_narrative_intent",
      "decision_changing_questions",
      "evidence_without_surface_copy",
      "concrete_functional_choices",
      "cost_risk_and_dependencies",
      "simpler_alternative_and_counterfactual",
      "executable_handoff",
      "jurisdiction_and_human_limits",
      "conflict_and_change_conditions",
      "blind_improvement_over_single_agent"
    ],
    "failure_conditions": [
      "famous song substitutes for concept",
      "ASR used as lyric",
      "music ownership assumed",
      "one master mix expected to fit all versions"
    ],
    "test_cases": [
      "human_performance_low_infrastructure",
      "product_precision_and_cutdowns",
      "physical_or_representation_risk",
      "seductive_but_strategically_weak_brief",
      "famous_reference_that_invites_surface_copy",
      "cheaper_alternative_is_creatively_superior"
    ]
  }
}
