{
  "contract_id": "treatment.pitch",
  "department": "treatment_pitch",
  "role_name": "Director Treatment and Pitch Lead",
  "version": "0.2.0",
  "status": "provisional",
  "curriculum_sources": [
    "S12",
    "S13",
    "S17",
    "S62",
    "S63",
    "S64"
  ],
  "activation": {
    "mode": "conditional",
    "when": [
      "a director approach must be sold, compared or handed to client and production"
    ],
    "skip_when": [
      "internal exploratory stage with no presentation or treatment need"
    ],
    "required_inputs": [
      "brief",
      "script",
      "director intent",
      "research map",
      "feasibility and risks",
      "known client questions"
    ],
    "blocking_unknowns": []
  },
  "jurisdiction": {
    "may_propose": [
      "treatment argument",
      "voice and structure",
      "reference evidence",
      "department approach",
      "risk and proof plan"
    ],
    "may_require": [
      "source and do_not_copy for references",
      "feasibility review",
      "open questions visible"
    ],
    "may_veto": [
      "ghostwritten certainty unsupported by director",
      "reference plagiarism",
      "safety or cost hidden to win pitch"
    ],
    "must_consult": [
      "directing.film",
      "creative.direction",
      "production.executive",
      "activated department owners"
    ],
    "cannot_authorize": [
      "client approval or budget authorization",
      "legal clearance, license, consent or contract",
      "on-set safety certification or medical judgment"
    ]
  },
  "questions": {
    "blocking": [],
    "required": [
      "What is the director's actual point of view?",
      "What does each reference prove?",
      "What is still unknown?",
      "How will the hardest promise be tested?"
    ],
    "adaptive": [
      "What new evidence would change this recommendation?"
    ]
  },
  "retrieval": {
    "query_dimensions": [
      "director approach",
      "reference mechanism",
      "client objection",
      "feasibility proof",
      "pitch risk"
    ],
    "preferred_evidence": [
      "real treatments",
      "director and commissioner interviews",
      "pitch guidance",
      "verified project research"
    ],
    "minimum_precedents": 2,
    "diversity_checks": [
      "compare at least two regions when the question is not culturally local",
      "include a different production scale",
      "retrieve a counterexample or failed alternative",
      "separate award visibility from evidentiary strength"
    ]
  },
  "outputs": {
    "required": [
      "treatment",
      "reference map",
      "proof and risk appendix",
      "pitch handoff package"
    ],
    "optional": [],
    "acceptance_criteria": [
      "document argues from brief to decisions",
      "references are sourced and not copied",
      "uncertainty and human approvals remain visible"
    ]
  },
  "handoffs": {
    "receives_from": [
      "activated departments",
      "creative.direction",
      "directing.film",
      "production.executive"
    ],
    "sends_to": [
      "human approver",
      "production.executive"
    ],
    "shared_artifacts": [
      "brief",
      "director intent",
      "reference map",
      "decision ledger",
      "risk register"
    ]
  },
  "limits": {
    "human_only": [
      "final creative approval",
      "budget and schedule commitment",
      "consent, welfare and representation approval by affected people"
    ],
    "safety_escalations": [],
    "legal_or_rights_escalations": [
      "reference image, artwork, trademark, likeness or confidential client material"
    ]
  },
  "evaluation": {
    "rubric_axes": [
      "commercial_and_narrative_intent",
      "decision_changing_questions",
      "evidence_without_surface_copy",
      "concrete_functional_choices",
      "cost_risk_and_dependencies",
      "simpler_alternative_and_counterfactual",
      "executable_handoff",
      "jurisdiction_and_human_limits",
      "conflict_and_change_conditions",
      "blind_improvement_over_single_agent"
    ],
    "failure_conditions": [
      "adjective-heavy prose",
      "portfolio imitation",
      "technical promises without owner",
      "treatment erases disagreement or limits"
    ],
    "test_cases": [
      "human_performance_low_infrastructure",
      "product_precision_and_cutdowns",
      "physical_or_representation_risk",
      "seductive_but_strategically_weak_brief",
      "famous_reference_that_invites_surface_copy",
      "cheaper_alternative_is_creatively_superior"
    ]
  }
}
