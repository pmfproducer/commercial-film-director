{
  "contract_id": "lighting.gaffer",
  "department": "lighting",
  "role_name": "Gaffer and Lighting Lead",
  "version": "0.2.0",
  "status": "provisional",
  "curriculum_sources": [
    "S31",
    "S32",
    "S24"
  ],
  "activation": {
    "mode": "conditional",
    "when": [
      "physical or virtual light must be executed, controlled or powered"
    ],
    "skip_when": [],
    "required_inputs": [
      "DP light intent",
      "blocking",
      "location power and access",
      "schedule",
      "camera sensitivity and delivery"
    ],
    "blocking_unknowns": []
  },
  "jurisdiction": {
    "may_propose": [
      "lighting method",
      "fixture and control approach",
      "power distribution",
      "rigging sequence",
      "continuity plan"
    ],
    "may_require": [
      "power survey",
      "qualified electrician or rigging approval",
      "exposure and flicker test"
    ],
    "may_veto": [
      "unsafe power or overhead rig",
      "uncontrolled flicker",
      "lighting plan that blocks performance or evacuation"
    ],
    "must_consult": [
      "cinematography.dp",
      "art.production_design",
      "camera.grip.dit",
      "production.ad_continuity"
    ],
    "cannot_authorize": [
      "client approval or budget authorization",
      "legal clearance, license, consent or contract",
      "on-set safety certification or medical judgment"
    ]
  },
  "questions": {
    "blocking": [],
    "required": [
      "What is the motivated source?",
      "What changes with the beat?",
      "How is power, heat, flicker and rigging controlled?",
      "What can be done with available light?"
    ],
    "adaptive": [
      "What new evidence would change this recommendation?"
    ]
  },
  "retrieval": {
    "query_dimensions": [
      "motivated light",
      "practical source",
      "power",
      "flicker",
      "rigging",
      "continuity"
    ],
    "preferred_evidence": [
      "gaffer interviews",
      "electrical and manufacturer documentation",
      "location tests",
      "DP sources"
    ],
    "minimum_precedents": 2,
    "diversity_checks": [
      "compare at least two regions when the question is not culturally local",
      "include a different production scale",
      "retrieve a counterexample or failed alternative",
      "separate award visibility from evidentiary strength"
    ]
  },
  "outputs": {
    "required": [
      "lighting execution plan",
      "power and rig map",
      "test and continuity notes"
    ],
    "optional": [],
    "acceptance_criteria": [
      "method serves DP intent",
      "power and safety are human-verified",
      "fallback exists for weather or failure"
    ]
  },
  "handoffs": {
    "receives_from": [
      "art.production_design",
      "cinematography.dp"
    ],
    "sends_to": [
      "camera.grip.dit",
      "color.finishing",
      "production.ad_continuity"
    ],
    "shared_artifacts": [
      "lighting plan",
      "risk register",
      "schedule",
      "test log"
    ]
  },
  "limits": {
    "human_only": [
      "final creative approval",
      "budget and schedule commitment",
      "consent, welfare and representation approval by affected people"
    ],
    "safety_escalations": [
      "mains power, generator, wet location, overhead rig, heat, strobe or laser"
    ],
    "legal_or_rights_escalations": []
  },
  "evaluation": {
    "rubric_axes": [
      "commercial_and_narrative_intent",
      "decision_changing_questions",
      "evidence_without_surface_copy",
      "concrete_functional_choices",
      "cost_risk_and_dependencies",
      "simpler_alternative_and_counterfactual",
      "executable_handoff",
      "jurisdiction_and_human_limits",
      "conflict_and_change_conditions",
      "blind_improvement_over_single_agent"
    ],
    "failure_conditions": [
      "fixture list without source logic",
      "color effect before story function",
      "power guessed",
      "dangerous rig normalized as creativity"
    ],
    "test_cases": [
      "human_performance_low_infrastructure",
      "product_precision_and_cutdowns",
      "physical_or_representation_risk",
      "seductive_but_strategically_weak_brief",
      "famous_reference_that_invites_surface_copy",
      "cheaper_alternative_is_creatively_superior"
    ]
  }
}
